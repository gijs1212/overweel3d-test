VITE_APPWRITE_ENDPOINT=https://appwrite.gijsoverweel.nl/v1
VITE_APPWRITE_PROJECT_ID=6af9acde00152998cadb
VITE_APPWRITE_DATABASE_ID=overweel3d-v2
VITE_APPWRITE_PUBLIC_BUCKET_ID=public-media-v2
VITE_APPWRITE_PRIVATE_BUCKET_ID=private-files-v2
VITE_APPWRITE_FUNCTION_ID=overweel3d-api

# Migratie/serveropslag. De draaiende Appwrite-stack moet dezelfde limiet via
# _APP_STORAGE_LIMIT toestaan voordat 250 MB-bestanden kunnen worden gebruikt.
APPWRITE_MAX_FILE_SIZE=262144000

# Alleen voor scripts/appwrite/deploy_function.py. Vul deze waarden uitsluitend
# in .env.appwrite.local in; nooit in de browserbuild of in Git.
RESEND_API_KEY=
RESEND_FROM=Overweel3D <noreply@overweel3d.gijsoverweel.nl>
# Rechtstreekse Appwrite Function-domain, zonder /v1. Deze URL bedient
# beveiligde klantbestanden na controle van het bestellingstoken.
APPWRITE_FUNCTION_PUBLIC_URL=
ONEDRIVE_TENANT_ID=ee379395-a204-487f-ac45-88e971655363
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REFRESH_TOKEN=
ONEDRIVE_REDIRECT_URI=https://overweel3d.gijsoverweel.nl/auth/callback

